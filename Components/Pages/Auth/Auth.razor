@page "/auth"
@layout MainLayout
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Auth</PageTitle>

<div class="main">
    <h3>Auth Test</h3>

    @if (_isLoggedIn)
    {
        <p>You are logged in as <strong>@_firstName @_lastName</strong> (email: @_email)</p>
    }
    else
    {
        <p>You are not logged in.</p>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p>@_message</p>
    }

    <h4>Login</h4>
    <form method="post" action="/auth/login">
        <AntiforgeryToken/>
        <input type="email" name="email" placeholder="Email" required/>
        <input type="password" name="password" placeholder="Password" required/>
        <button type="submit">Login</button>
    </form>

    <h4>Register</h4>
    <div>
        <input type="text" placeholder="First Name" @bind="_registerFirstName"/>
        <input type="text" placeholder="Last Name" @bind="_registerLastName"/>
        <input type="email" placeholder="Email" @bind="_registerEmail"/>
        <input type="password" placeholder="Password" @bind="_registerPassword"/>
        <button @onclick="OnRegister">Register</button>
    </div>

    @if (_isLoggedIn)
    {
        <form method="post" action="/auth/logout">
            <AntiforgeryToken/>
            <button type="submit">Logout</button>
        </form>
    }
</div>

@code {
    [Inject] private AuthService AuthService { get; set; } = null;

    private string? Error { get; set; }

    private bool _isLoggedIn;
    private string? _firstName;
    private string? _lastName;
    private string? _email;
    private string? _message;

    private string _registerFirstName = string.Empty;
    private string _registerLastName = string.Empty;
    private string _registerEmail = string.Empty;
    private string _registerPassword = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Error))
        {
            _message = $"Login failed: {Error}";
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        _isLoggedIn = user.Identity?.IsAuthenticated == true;

        if (_isLoggedIn)
        {
            // Uses the names from ClaimTypes instead of making database query, we should do this in the navbar too.
            _firstName = user.FindFirstValue(ClaimTypes.GivenName);
            _lastName = user.FindFirstValue(ClaimTypes.Surname);
            _email = user.FindFirstValue(ClaimTypes.Email);
        }
    }

    private async Task OnRegister()
    {
        var result = await AuthService.RegisterAsync(_registerFirstName, _registerLastName, _registerEmail, _registerPassword);

        _message = result.Success ? "Registration successful!" : $"Registration failed: {result.Error}";
    }
}