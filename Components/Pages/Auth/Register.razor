@page "/auth/register"
@layout MainLayout
@inject AuthService AuthService

<PageTitle>Registreren</PageTitle>

<div class="main">
    <div class="login-container">
        <div class="login-header">
            <h3>Registreren</h3>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="@(_registrationSucceeded ? "success-message" : "error-message")">@_message</p>
        }

        <form @onsubmit="OnRegister">
            <AntiforgeryToken />
            <input type="text" placeholder="Voornaam" @bind="_firstName" required />
            <input type="text" placeholder="Achternaam" @bind="_lastName" required />
            <input type="email" placeholder="E-mailadres" @bind="_email" required />
            <input type="password" placeholder="Wachtwoord (minimaal 8 tekens)" @bind="_password" minlength="8" required />
            <input type="password" placeholder="Wachtwoord bevestigen" @bind="_confirmPassword" minlength="8" required />
            <button type="submit">Registreren</button>
        </form>

        <div class="register-link">
            <p>Heb je al een account? <a href="/auth/login">Inloggen</a></p>
        </div>
    </div>
</div>

@code {
    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _message;
    private bool _registrationSucceeded;

    private async Task OnRegister()
    {
        if (_password.Length < 8)
        {
            _registrationSucceeded = false;
            _message = "Het wachtwoord moet minimaal 8 tekens lang zijn.";
            return;
        }

        if (_password != _confirmPassword)
        {
            _registrationSucceeded = false;
            _message = "De wachtwoorden komen niet overeen.";
            return;
        }

        var result = await AuthService.RegisterAsync(_firstName, _lastName, _email, _password);

        _registrationSucceeded = result.Success;
        _message = result.Success
            ? "Registratie geslaagd! Je kunt nu inloggen."
            : $"Registratie mislukt: {result.Error}";
    }
}
