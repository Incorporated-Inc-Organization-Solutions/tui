@namespace tui.Components.Sales

<div class="of-page">
    <div class="of-header">
        <div>
            <h1 class="of-title">Offertes</h1>
            <p class="of-sub">Beheer en verstuur reisoffertes</p>
        </div>
        <button class="btn btn-primary" @onclick="() => NieuwOfferte = true">+ Nieuwe Offerte</button>
    </div>

    <!-- Quick stats -->
    <div class="of-stats">
        <div class="of-stat">
            <p class="of-stat-label">Open</p>
            <p class="of-stat-value blue">@Stats.Open</p>
        </div>
        <div class="of-stat">
            <p class="of-stat-label">Geaccepteerd</p>
            <p class="of-stat-value green">@Stats.Geaccepteerd</p>
        </div>
        <div class="of-stat">
            <p class="of-stat-label">Verlopen</p>
            <p class="of-stat-value muted">@Stats.Verlopen</p>
        </div>
    </div>

    <!-- Status filters -->
    <div class="of-filters">
        @foreach (var s in StatusFilters)
        {
            <button class="filter-btn @(FilterStatus == s ? "filter-btn-active" : "")"
                    @onclick="() => FilterStatus = s">
                @s
            </button>
        }
    </div>

    <!-- Table -->
    <div class="of-table card">
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Offerte</th>
                        <th>Klant</th>
                        <th>Reis</th>
                        <th>Personen</th>
                        <th>Datum</th>
                        <th>Verloopt</th>
                        <th>Bedrag</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Gefilterd)
                    {
                        <tr class="table-row">
                            <td class="cell mono muted">@o.Id</td>
                            <td class="cell name">@o.Klant</td>
                            <td class="cell nowrap">@o.Reis</td>
                            <td class="cell center muted">@o.Personen</td>
                            <td class="cell muted nowrap">@o.Datum</td>
                            <td class="cell muted nowrap">@o.Verloopt</td>
                            <td class="cell mono nowrap">@o.Bedrag</td>
                            <td class="cell"><span class="badge @StatusKleur(o.Status)">@o.Status</span></td>
                            <td class="cell">
                                <div class="row-actions">
                                    <button class="mini-btn">Bekijk</button>
                                    @if (o.Status == "open")
                                    {
                                        <button class="mini-btn mini-btn-primary">Stuur</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- New offerte modal -->
    @if (NieuwOfferte)
    {
        <div class="modal-backdrop" @onclick="() => NieuwOfferte = false">
            <div class="modal modal-narrow" @onclick.stop>
                <div class="modal-head-row">
                    <h2 class="modal-title-sm">Nieuwe Offerte</h2>
                    <button class="modal-x" @onclick="() => NieuwOfferte = false">×</button>
                </div>
                <div class="modal-fields">
                    <div class="field">
                        <label class="field-label">Klant</label>
                        <input type="text" placeholder="Naam of zoek klant..." @bind="Form.Klant" class="field-input" />
                    </div>
                    <div class="field">
                        <label class="field-label">Reis</label>
                        <input type="text" placeholder="Selecteer bestemming..." @bind="Form.Reis" class="field-input" />
                    </div>
                    <div class="field">
                        <label class="field-label">Aantal personen</label>
                        <input type="number" @bind="Form.Personen" class="field-input" />
                    </div>
                    <div class="field">
                        <label class="field-label">Notities</label>
                        <textarea rows="3" placeholder="Wensen en opmerkingen..." @bind="Form.Notities" class="field-input resize-none"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary flex1" @onclick="() => NieuwOfferte = false">Offerte Aanmaken</button>
                    <button class="btn btn-muted" @onclick="() => NieuwOfferte = false">Annuleren</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private sealed record Offerte(string Id, string Klant, string Reis, string Datum, string Verloopt, string Bedrag, string Status, int Personen);

    private static readonly string[] StatusFilters = { "alle", "open", "geaccepteerd", "verlopen", "afgewezen" };

    private static readonly Offerte[] OffertesData =
    {
        new("OF-5521", "Mia Jansen", "Japan Rondreis", "28 aug 2026", "11 sep 2026", "€ 2.890", "open", 2),
        new("OF-5520", "Bram de Boer", "Patagonie Trek", "25 aug 2026", "8 sep 2026", "€ 6.480", "verlopen", 2),
        new("OF-5519", "Sara Linden", "Peru Avontuur", "20 aug 2026", "3 sep 2026", "€ 4.150", "geaccepteerd", 1),
        new("OF-5518", "Kevin Meijer", "IJsland Ring Road", "18 aug 2026", "1 sep 2026", "€ 3.960", "open", 2),
        new("OF-5517", "Nora Vos", "Marokko Avontuur", "14 aug 2026", "28 aug 2026", "€ 2.100", "geaccepteerd", 1),
        new("OF-5516", "Finn Hoekstra", "Vietnam Noord-Zuid", "10 aug 2026", "24 aug 2026", "€ 2.650", "afgewezen", 1),
        new("OF-5515", "Iris van Dam", "Japan Rondreis", "5 aug 2026", "19 aug 2026", "€ 5.780", "geaccepteerd", 2),
    };

    private string FilterStatus { get; set; } = "alle";
    private bool NieuwOfferte { get; set; }
    private OfferteForm Form { get; set; } = new();

    private sealed class OfferteForm
    {
        public string Klant { get; set; } = string.Empty;
        public string Reis { get; set; } = string.Empty;
        public string Personen { get; set; } = "1";
        public string Notities { get; set; } = string.Empty;
    }

    private IEnumerable<Offerte> Gefilterd =>
        OffertesData.Where(o => FilterStatus == "alle" || o.Status == FilterStatus);

    private (int Open, int Geaccepteerd, int Verlopen) Stats => (
        OffertesData.Count(o => o.Status == "open"),
        OffertesData.Count(o => o.Status == "geaccepteerd"),
        OffertesData.Count(o => o.Status == "verlopen"));

    private static string StatusKleur(string status) => status switch
    {
        "open" => "badge-blue",
        "geaccepteerd" => "badge-green",
        "verlopen" => "badge-muted",
        "afgewezen" => "badge-red",
        _ => "badge-muted",
    };
}

<style>
    .of-page {
        padding: 1.5rem;
    }

    @@media (min-width: 768px) {
        .of-page {
            padding: 2rem;
        }
    }

    .of-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

    .of-title {
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 1.875rem;
        color: var(--foreground);
        margin: 0;
    }

    .of-sub {
        color: var(--muted-foreground);
        font-size: 0.875rem;
        margin: 0.25rem 0 0 0;
    }

    .btn {
        padding: 0.625rem 1rem;
        border-radius: 0.25rem;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 150ms ease;
        border: none;
    }

    .btn-primary {
        background: var(--primary);
        color: #fff;
    }

    .btn-primary:hover {
        background: rgba(255, 92, 53, 0.9);
    }

    .btn-muted {
        background: var(--secondary);
        color: var(--muted-foreground);
        border: 1px solid var(--border);
    }

    .btn-muted:hover {
        color: var(--foreground);
    }

    .flex1 {
        flex: 1;
    }

    .of-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .of-stat {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
    }

    .of-stat-label {
        font-size: 10px;
        font-family: 'JetBrains Mono', monospace;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted-foreground);
        margin: 0 0 0.25rem 0;
    }

    .of-stat-value {
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        font-size: 1.25rem;
        margin: 0;
    }

    .blue {
        color: #60a5fa;
    }

    .green {
        color: #4ade80;
    }

    .muted {
        color: var(--muted-foreground);
    }

    .of-filters {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
    }

    .filter-btn {
        padding: 0.375rem 0.75rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        font-weight: 500;
        background: transparent;
        border: none;
        color: var(--muted-foreground);
        cursor: pointer;
        text-transform: capitalize;
        transition: all 150ms ease;
    }

    .filter-btn:hover {
        color: var(--foreground);
        background: var(--secondary);
    }

    .filter-btn-active {
        background: var(--primary);
        color: #fff;
    }

    .filter-btn-active:hover {
        color: #fff;
    }

    .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .table-wrap {
        overflow-x: auto;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
    }

    .table thead tr {
        border-bottom: 1px solid var(--border);
    }

    .table th {
        padding: 0.75rem 1rem;
        text-align: left;
        font-size: 10px;
        font-family: 'JetBrains Mono', monospace;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted-foreground);
        white-space: nowrap;
    }

    .table-row {
        border-bottom: 1px solid var(--border);
        transition: background-color 150ms ease;
    }

    .table-row:last-child {
        border-bottom: none;
    }

    .table-row:hover {
        background: var(--secondary);
    }

    .cell {
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        color: var(--foreground);
    }

    .cell.mono {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
    }

    .cell.name {
        font-weight: 500;
    }

    .cell.muted {
        color: var(--muted-foreground);
        font-size: 0.75rem;
    }

    .cell.center {
        text-align: center;
    }

    .cell.nowrap {
        white-space: nowrap;
    }

    .badge {
        padding: 0.125rem 0.5rem;
        border-radius: 0.25rem;
        border: 1px solid transparent;
        font-size: 10px;
        font-weight: 500;
        text-transform: capitalize;
        white-space: nowrap;
        display: inline-block;
    }

    .badge-blue {
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
        border-color: rgba(59, 130, 246, 0.2);
    }

    .badge-green {
        background: rgba(34, 197, 94, 0.15);
        color: #4ade80;
        border-color: rgba(34, 197, 94, 0.2);
    }

    .badge-red {
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        border-color: rgba(239, 68, 68, 0.2);
    }

    .badge-muted {
        background: var(--muted);
        color: var(--muted-foreground);
    }

    .row-actions {
        display: flex;
        gap: 0.25rem;
    }

    .mini-btn {
        padding: 0.25rem 0.5rem;
        background: var(--secondary);
        color: var(--muted-foreground);
        border: none;
        border-radius: 0.25rem;
        font-size: 10px;
        cursor: pointer;
        transition: color 150ms ease;
    }

    .mini-btn:hover {
        color: var(--foreground);
    }

    .mini-btn-primary {
        background: rgba(255, 92, 53, 0.1);
        color: var(--primary);
    }

    .mini-btn-primary:hover {
        background: rgba(255, 92, 53, 0.2);
        color: var(--primary);
    }

    .modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(0, 0, 0, 0.6);
    }

    .modal {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        width: 100%;
        overflow: hidden;
    }

    .modal-narrow {
        max-width: 28rem;
        padding: 1.5rem;
    }

    .modal-head-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
    }

    .modal-title-sm {
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        font-size: 1.125rem;
        color: var(--foreground);
        margin: 0;
    }

    .modal-x {
        background: none;
        border: none;
        color: var(--muted-foreground);
        font-size: 1.125rem;
        cursor: pointer;
    }

    .modal-x:hover {
        color: var(--foreground);
    }

    .modal-fields {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .field-label {
        display: block;
        font-size: 0.75rem;
        font-family: 'JetBrains Mono', monospace;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted-foreground);
        margin-bottom: 0.375rem;
    }

    .field-input {
        width: 100%;
        padding: 0.625rem 0.75rem;
        background: var(--background);
        border: 1px solid var(--border);
        border-radius: 0.25rem;
        font-size: 0.875rem;
        color: var(--foreground);
    }

    .field-input::placeholder {
        color: var(--muted-foreground);
    }

    .field-input:focus {
        outline: none;
        border-color: var(--primary);
    }

    .resize-none {
        resize: none;
    }

    .modal-footer {
        display: flex;
        gap: 0.75rem;
        padding-top: 0.25rem;
    }
</style>
