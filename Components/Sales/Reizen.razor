@namespace tui.Components.Sales

<div class="rz-page">
    <div class="rz-header">
        <div>
            <h1 class="rz-title">Reizen</h1>
            <p class="rz-sub">@ReizenData.Length reizen in de catalogus</p>
        </div>
        <button class="btn btn-primary">+ Nieuwe Reis</button>
    </div>

    <!-- Filters -->
    <div class="rz-filters">
        <input type="text" placeholder="Zoek reizen..." @bind="Zoek" @bind:event="oninput" class="input w56" />
        <div class="filter-group">
            @foreach (var c in Categories)
            {
                <button class="filter-btn @(Filter == c ? "filter-btn-active" : "")"
                        @onclick="() => Filter = c">
                    @c
                </button>
            }
        </div>
    </div>

    <!-- Cards -->
    <div class="rz-grid">
        @foreach (var r in Gefilterd)
        {
            <div class="rz-card" @onclick="() => Geselecteerd = r">
                <div class="rz-imgwrap">
                    <img src="@r.Img" alt="@r.Naam" class="rz-img" />
                    <div class="rz-imgoverlay"></div>
                    <div class="rz-imglabel">
                        <span class="rz-tag">@r.Categorie</span>
                        @if (r.Status == "volgeboekt")
                        {
                            <span class="rz-tag rz-tag-vol">Vol</span>
                        }
                    </div>
                    <div class="rz-imgfoot">
                        <span class="rz-imgsmall mono">@r.Id</span>
                        <span class="rz-imgprice">@r.Prijs</span>
                    </div>
                </div>
                <div class="rz-body">
                    <h3 class="rz-name">@r.Naam</h3>
                    <div class="rz-meta">
                        <span>@r.Duur</span>
                        <span>@(r.Beschikbaar > 0 ? $"{r.Beschikbaar} plekken vrij" : "Volgeboekt")</span>
                    </div>
                    <div class="rz-tags">
                        @foreach (var t in r.Tags)
                        {
                            <span class="rz-tag-grey">@t</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Detail modal -->
    @if (Geselecteerd is not null)
    {
        <div class="modal-backdrop" @onclick="() => Geselecteerd = null">
            <div class="modal" @onclick.stop>
                <div class="modal-imgwrap">
                    <img src="@Geselecteerd.Img" alt="@Geselecteerd.Naam" class="modal-img" />
                    <div class="rz-imgoverlay"></div>
                    <button class="modal-close" @onclick="() => Geselecteerd = null">×</button>
                    <div class="modal-head">
                        <p class="modal-id mono">@Geselecteerd.Id</p>
                        <h2 class="modal-title">@Geselecteerd.Naam</h2>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="modal-stats">
                        <div class="modal-stat">
                            <p class="modal-stat-label">Duur</p>
                            <p class="modal-stat-value">@Geselecteerd.Duur</p>
                        </div>
                        <div class="modal-stat">
                            <p class="modal-stat-label">Prijs</p>
                            <p class="modal-stat-value">@Geselecteerd.Prijs</p>
                        </div>
                        <div class="modal-stat">
                            <p class="modal-stat-label">Beschikbaar</p>
                            <p class="modal-stat-value">@(Geselecteerd.Beschikbaar > 0 ? $"{Geselecteerd.Beschikbaar} plekken" : "Vol")</p>
                        </div>
                    </div>
                    <div class="modal-actions">
                        <button class="btn btn-primary flex1">Offerte Aanmaken</button>
                        <button class="btn btn-ghost flex1">Reis Bewerken</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private sealed record Reis(string Id, string Naam, string Categorie, string Duur, string Prijs, int Beschikbaar, string Img, string[] Tags, string Status);

    private static readonly Reis[] ReizenData =
    {
        new("R-101", "Patagonie Trek — Torres del Paine", "Avontuur", "14 dagen", "€ 3.240", 8, "https://images.unsplash.com/photo-1501854140801-50d01698950b?w=400&h=240&fit=crop&auto=format", new[] { "trekking", "natuur", "groep" }, "actief"),
        new("R-102", "Japan Rondreis — Tradities & Neon", "Cultuur", "16 dagen", "€ 2.890", 12, "https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=400&h=240&fit=crop&auto=format", new[] { "cultuur", "steden", "eten" }, "actief"),
        new("R-103", "IJsland Ring Road", "Natuur", "10 dagen", "€ 1.980", 5, "https://images.unsplash.com/photo-1504233529578-6d46baba6d34?w=400&h=240&fit=crop&auto=format", new[] { "noorderlicht", "auto", "solo" }, "actief"),
        new("R-104", "Peru Avontuur — Machu Picchu", "Avontuur", "12 dagen", "€ 4.150", 3, "https://images.unsplash.com/photo-1526392060635-9d6019884377?w=400&h=240&fit=crop&auto=format", new[] { "inca", "trekking", "hoogte" }, "actief"),
        new("R-105", "Marokko — Sahara & Medina", "Cultuur", "9 dagen", "€ 2.100", 14, "https://images.unsplash.com/photo-1539635278303-d4002c07eae3?w=400&h=240&fit=crop&auto=format", new[] { "woestijn", "souks", "groep" }, "actief"),
        new("R-106", "Vietnam van Noord naar Zuid", "Avontuur", "18 dagen", "€ 2.650", 0, "https://images.unsplash.com/photo-1557750255-c76072a7aad1?w=400&h=240&fit=crop&auto=format", new[] { "motortocht", "eten", "strand" }, "volgeboekt"),
    };

    private static readonly string[] Categories = { "Alle", "Avontuur", "Cultuur", "Natuur" };

    private string Filter { get; set; } = "Alle";
    private string Zoek { get; set; } = string.Empty;
    private Reis? Geselecteerd { get; set; }

    private IEnumerable<Reis> Gefilterd =>
        ReizenData.Where(r =>
            (Filter == "Alle" || r.Categorie == Filter) &&
            r.Naam.Contains(Zoek, StringComparison.OrdinalIgnoreCase));
}

<style>
    .rz-page {
        padding: 1.5rem;
    }

    @@media (min-width: 768px) {
        .rz-page {
            padding: 2rem;
        }
    }

    .rz-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

    .rz-title {
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 1.875rem;
        color: var(--foreground);
        margin: 0;
    }

    .rz-sub {
        color: var(--muted-foreground);
        font-size: 0.875rem;
        margin: 0.25rem 0 0 0;
    }

    .btn {
        padding: 0.625rem 1rem;
        border-radius: 0.25rem;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 150ms ease;
        border: none;
    }

    .btn-primary {
        background: var(--primary);
        color: #fff;
    }

    .btn-primary:hover {
        background: rgba(255, 92, 53, 0.9);
    }

    .btn-ghost {
        background: var(--secondary);
        color: var(--foreground);
        border: 1px solid var(--border);
    }

    .btn-ghost:hover {
        background: var(--muted);
    }

    .flex1 {
        flex: 1;
    }

    .rz-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .input {
        padding: 0.5rem 0.75rem;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 0.25rem;
        font-size: 0.875rem;
        color: var(--foreground);
    }

    .input::placeholder {
        color: var(--muted-foreground);
    }

    .input:focus {
        outline: none;
        border-color: var(--primary);
    }

    .w56 {
        width: 14rem;
    }

    .filter-group {
        display: flex;
        gap: 0.25rem;
    }

    .filter-btn {
        padding: 0.5rem 0.75rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        font-weight: 500;
        background: transparent;
        border: none;
        color: var(--muted-foreground);
        cursor: pointer;
        transition: all 150ms ease;
    }

    .filter-btn:hover {
        color: var(--foreground);
    }

    .filter-btn-active {
        background: var(--primary);
        color: #fff;
    }

    .filter-btn-active:hover {
        color: #fff;
    }

    .rz-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }

    @@media (min-width: 640px) {
        .rz-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (min-width: 1280px) {
        .rz-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .rz-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        overflow: hidden;
        cursor: pointer;
        transition: border-color 150ms ease;
    }

    .rz-card:hover {
        border-color: rgba(255, 92, 53, 0.4);
    }

    .rz-imgwrap {
        position: relative;
        height: 11rem;
        background: var(--secondary);
        overflow: hidden;
    }

    .rz-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 500ms ease;
    }

    .rz-card:hover .rz-img {
        transform: scale(1.05);
    }

    .rz-imgoverlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent);
    }

    .rz-imglabel {
        position: absolute;
        top: 0.75rem;
        left: 0.75rem;
        display: flex;
        gap: 0.375rem;
    }

    .rz-tag {
        padding: 0.125rem 0.5rem;
        border-radius: 0.25rem;
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 10px;
        font-family: 'JetBrains Mono', monospace;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: rgba(255, 255, 255, 0.8);
    }

    .rz-tag-vol {
        background: rgba(255, 92, 53, 0.8);
        color: #fff;
    }

    .rz-imgfoot {
        position: absolute;
        bottom: 0.75rem;
        left: 0.75rem;
        right: 0.75rem;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
    }

    .rz-imgsmall {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.6);
    }

    .rz-imgprice {
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        color: #fff;
        font-size: 1.125rem;
    }

    .mono {
        font-family: 'JetBrains Mono', monospace;
    }

    .rz-body {
        padding: 1rem;
    }

    .rz-name {
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        font-size: 0.875rem;
        color: var(--foreground);
        margin: 0 0 0.25rem 0;
        line-height: 1.3;
    }

    .rz-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.75rem;
        color: var(--muted-foreground);
        margin-bottom: 0.75rem;
    }

    .rz-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
    }

    .rz-tag-grey {
        padding: 0.125rem 0.5rem;
        border-radius: 0.25rem;
        background: var(--secondary);
        font-size: 10px;
        color: var(--muted-foreground);
    }

    /* Modal */
    .modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(0, 0, 0, 0.6);
    }

    .modal {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        width: 100%;
        max-width: 32rem;
        overflow: hidden;
    }

    .modal-imgwrap {
        position: relative;
        height: 13rem;
        background: var(--secondary);
    }

    .modal-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .modal-close {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        width: 1.75rem;
        height: 1.75rem;
        border-radius: 0.25rem;
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.8);
        cursor: pointer;
        font-size: 0.875rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-close:hover {
        color: #fff;
    }

    .modal-head {
        position: absolute;
        bottom: 1rem;
        left: 1rem;
    }

    .modal-id {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.5);
        margin: 0 0 0.125rem 0;
    }

    .modal-title {
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 1.25rem;
        color: #fff;
        margin: 0;
        line-height: 1.25;
    }

    .modal-body {
        padding: 1.25rem;
    }

    .modal-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .modal-stat {
        background: var(--secondary);
        border-radius: 0.25rem;
        padding: 0.75rem;
    }

    .modal-stat-label {
        font-size: 10px;
        font-family: 'JetBrains Mono', monospace;
        text-transform: uppercase;
        color: var(--muted-foreground);
        margin: 0 0 0.25rem 0;
    }

    .modal-stat-value {
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        font-size: 0.875rem;
        color: var(--foreground);
        margin: 0;
    }

    .modal-actions {
        display: flex;
        gap: 0.75rem;
    }
</style>
