@namespace tui.Components.Sales

<div class="dash-page">
    <!-- Header -->
    <div class="dash-header">
        <div>
            <h1 class="dash-title">Sales Dashboard</h1>
            <p class="dash-sub">Donderdag, 3 september 2026 — Goedemiddag, Jana</p>
        </div>
        <div class="dash-period">
            @foreach (var p in Perioden)
            {
                <button class="period-btn @(Period == p ? "period-btn-active" : "")"
                        @onclick="() => Period = p">
                    @p
                </button>
            }
        </div>
    </div>

    <!-- Stats grid -->
    <div class="dash-stats">
        @foreach (var s in Stats)
        {
            <div class="stat-card">
                <p class="stat-label">@s.Label</p>
                <p class="stat-value">@s.Value</p>
                <p class="stat-delta @(s.Positive ? "stat-delta-pos" : "stat-delta-warn")">@s.Delta</p>
            </div>
        }
    </div>

    <!-- Main grid -->
    <div class="dash-grid">
        <!-- Recent bookings -->
        <div class="card dash-recent">
            <div class="card-head">
                <h2 class="card-title">Recente Boekingen</h2>
                <span class="card-count">5 van 124</span>
            </div>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Klant</th>
                            <th>Bestemming</th>
                            <th>Vertrek</th>
                            <th>Status</th>
                            <th>Bedrag</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < RecentBookings.Length; i++)
                        {
                            var b = RecentBookings[i];
                            <tr class="table-row @(i % 2 == 0 ? "" : "table-row-alt")">
                                <td class="cell mono muted">@b.Id</td>
                                <td class="cell name">@b.Klant</td>
                                <td class="cell">@b.Bestemming</td>
                                <td class="cell muted">@b.Vertrek</td>
                                <td class="cell"><span class="badge @StatusBadge(b.Status)">@b.Status</span></td>
                                <td class="cell mono">@b.Bedrag</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Right column -->
        <div class="dash-right">
            <!-- Sales pipeline -->
            <div class="card card-pad">
                <h2 class="card-title">Sales Pipeline</h2>
                <div class="pipe-list">
                    @foreach (var p in Pipeline)
                    {
                        <div class="pipe-item">
                            <div class="pipe-label">
                                <span>@p.Fase</span>
                                <span class="mono">@p.Aantal</span>
                            </div>
                            <div class="pipe-track">
                                <div class="pipe-fill" style="width: @((p.Aantal / 45.0 * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%; background: @p.Kleur;"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Top destinations -->
            <div class="card card-pad">
                <h2 class="card-title">Top Bestemmingen</h2>
                <div class="top-list">
                    @foreach (var d in TopDestinations)
                    {
                        <div class="top-item">
                            <img src="@d.Img" alt="@d.Naam" class="top-img" />
                            <div class="top-info">
                                <p class="top-name">@d.Naam</p>
                                <p class="top-sub">@d.Boekingen boekingen</p>
                            </div>
                            <div class="top-track">
                                <div class="top-fill" style="width: @((d.Boekingen / 34.0 * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Action buttons -->
    <div class="dash-actions">
        <button class="btn btn-primary">+ Nieuwe Boeking</button>
        <button class="btn btn-ghost">Offerte Opstellen</button>
        <button class="btn btn-ghost">Rapport Exporteren</button>
    </div>
</div>

@code {
    private sealed record Stat(string Label, string Value, string Delta, bool Positive);
    private sealed record RecentBooking(string Id, string Klant, string Bestemming, string Vertrek, string Status, string Bedrag);
    private sealed record PipelineItem(string Fase, int Aantal, string Kleur);
    private sealed record Destination(string Naam, int Boekingen, string Img);

    private static readonly string[] Perioden = { "week", "maand", "kwartaal" };

    private static readonly Stat[] Stats =
    {
        new("Actieve Boekingen", "124", "+12 deze week", true),
        new("Open Offertes", "38", "8 vervallen binnenkort", false),
        new("Omzet Maand", "€ 184.600", "+23% vs vorige maand", true),
        new("Nieuwe Klanten", "27", "+5 vs vorige week", true),
    };

    private static readonly RecentBooking[] RecentBookings =
    {
        new("BK-2847", "Lena Hartman", "Patagonie Trek", "15 mrt 2026", "bevestigd", "€ 3.240"),
        new("BK-2846", "Daan Mulder", "Japan Rondreis", "22 mrt 2026", "in behandeling", "€ 2.890"),
        new("BK-2845", "Sofie Bakker", "Peru Avontuur", "1 apr 2026", "bevestigd", "€ 4.150"),
        new("BK-2844", "Tim de Vries", "IJsland Ring Road", "8 apr 2026", "wacht betaling", "€ 1.980"),
        new("BK-2843", "Emma Smit", "Marokko Avontuur", "12 apr 2026", "bevestigd", "€ 2.100"),
    };

    private static readonly PipelineItem[] Pipeline =
    {
        new("Lead", 45, "#4a90d9"),
        new("Offerte Gestuurd", 22, "#f59e0b"),
        new("Onderhandeling", 14, "#ff5c35"),
        new("Gesloten", 9, "#22c55e"),
    };

    private static readonly Destination[] TopDestinations =
    {
        new("Japan Rondreis", 34, "https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=80&h=80&fit=crop&auto=format"),
        new("Patagonie Trek", 28, "https://images.unsplash.com/photo-1501854140801-50d01698950b?w=80&h=80&fit=crop&auto=format"),
        new("IJsland Ring Road", 22, "https://images.unsplash.com/photo-1504233529578-6d46baba6d34?w=80&h=80&fit=crop&auto=format"),
        new("Peru Avontuur", 19, "https://images.unsplash.com/photo-1526392060635-9d6019884377?w=80&h=80&fit=crop&auto=format"),
    };

    private string Period { get; set; } = "maand";

    private static string StatusBadge(string status) => status switch
    {
        "bevestigd" => "badge-green",
        "in behandeling" => "badge-amber",
        "wacht betaling" => "badge-orange",
        _ => "badge-muted",
    };
}

<style>
    .dash-page {
        padding: 1.5rem;
    }

    @@media (min-width: 768px) {
        .dash-page {
            padding: 2rem;
        }
    }

    .dash-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

    .dash-title {
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 1.875rem;
        color: var(--foreground);
        line-height: 1.25;
        margin: 0;
    }

    .dash-sub {
        color: var(--muted-foreground);
        font-size: 0.875rem;
        margin: 0.25rem 0 0 0;
    }

    .dash-period {
        display: flex;
        gap: 0.5rem;
    }

    .period-btn {
        padding: 0.375rem 0.75rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        font-weight: 500;
        background: transparent;
        border: none;
        color: var(--muted-foreground);
        cursor: pointer;
        text-transform: capitalize;
        transition: all 150ms ease;
    }

    .period-btn:hover {
        color: var(--foreground);
        background: var(--secondary);
    }

    .period-btn-active {
        background: var(--primary);
        color: #fff;
    }

    .period-btn-active:hover {
        background: var(--primary);
        color: #fff;
    }

    .dash-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    @@media (min-width: 1024px) {
        .dash-stats {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    .stat-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 1.25rem;
    }

    .stat-label {
        font-size: 11px;
        font-family: 'JetBrains Mono', monospace;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted-foreground);
        margin: 0 0 0.5rem 0;
    }

    .stat-value {
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        font-size: 1.5rem;
        color: var(--foreground);
        margin: 0 0 0.25rem 0;
    }

    .stat-delta {
        font-size: 0.75rem;
        margin: 0;
    }

    .stat-delta-pos {
        color: #4ade80;
    }

    .stat-delta-warn {
        color: #fbbf24;
    }

    .dash-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    @@media (min-width: 1024px) {
        .dash-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .dash-recent {
            grid-column: span 2;
        }
    }

    .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .card-pad {
        padding: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .card-head {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .card-title {
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        font-size: 0.875rem;
        color: var(--foreground);
        margin: 0;
    }

    .card-count {
        font-size: 0.75rem;
        color: var(--muted-foreground);
        font-family: 'JetBrains Mono', monospace;
    }

    .table-wrap {
        overflow-x: auto;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
    }

    .table thead tr {
        border-bottom: 1px solid var(--border);
    }

    .table th {
        padding: 0.75rem 1rem;
        text-align: left;
        font-size: 10px;
        font-family: 'JetBrains Mono', monospace;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted-foreground);
    }

    .table-row {
        border-bottom: 1px solid var(--border);
        cursor: pointer;
        transition: background-color 150ms ease;
    }

    .table-row:last-child {
        border-bottom: none;
    }

    .table-row:hover {
        background: var(--secondary);
    }

    .table-row-alt {
        background: rgba(10, 15, 30, 0.3);
    }

    .cell {
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        color: var(--foreground);
    }

    .cell.mono {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
    }

    .cell.name {
        font-weight: 500;
    }

    .cell.muted {
        color: var(--muted-foreground);
    }

    .badge {
        padding: 0.125rem 0.5rem;
        border-radius: 0.25rem;
        border: 1px solid transparent;
        font-size: 10px;
        font-weight: 500;
        text-transform: capitalize;
        white-space: nowrap;
        display: inline-block;
    }

    .badge-green {
        background: rgba(34, 197, 94, 0.15);
        color: #4ade80;
        border-color: rgba(34, 197, 94, 0.2);
    }

    .badge-amber {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        border-color: rgba(245, 158, 11, 0.2);
    }

    .badge-orange {
        background: rgba(255, 92, 53, 0.15);
        color: var(--primary);
        border-color: rgba(255, 92, 53, 0.2);
    }

    .badge-muted {
        background: var(--muted);
        color: var(--muted-foreground);
    }

    .dash-right {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .pipe-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .pipe-item {
        margin-bottom: 0;
    }

    .pipe-label {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        margin-bottom: 0.25rem;
    }

    .pipe-label span:first-child {
        color: var(--muted-foreground);
    }

    .pipe-label .mono {
        font-family: 'JetBrains Mono', monospace;
        color: var(--foreground);
    }

    .pipe-track {
        height: 6px;
        background: var(--secondary);
        border-radius: 50px;
        overflow: hidden;
    }

    .pipe-fill {
        height: 100%;
        border-radius: 50px;
        transition: width 500ms ease;
    }

    .top-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .top-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .top-img {
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 0.25rem;
        object-fit: cover;
        background: var(--secondary);
        flex-shrink: 0;
    }

    .top-info {
        flex: 1;
        min-width: 0;
    }

    .top-name {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--foreground);
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .top-sub {
        font-size: 10px;
        color: var(--muted-foreground);
        margin: 0;
    }

    .top-track {
        width: 4rem;
        height: 4px;
        background: var(--secondary);
        border-radius: 50px;
        overflow: hidden;
        flex-shrink: 0;
    }

    .top-fill {
        height: 100%;
        background: var(--primary);
        border-radius: 50px;
    }

    .dash-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1rem;
        border-radius: 0.25rem;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 150ms ease;
    }

    .btn-primary {
        background: var(--primary);
        color: #fff;
        border: none;
    }

    .btn-primary:hover {
        background: rgba(255, 92, 53, 0.9);
    }

    .btn-ghost {
        background: var(--secondary);
        color: var(--foreground);
        border: 1px solid var(--border);
    }

    .btn-ghost:hover {
        background: var(--muted);
    }
</style>
