@inherits LayoutComponentBase
@inject NavigationManager Nav
@implements IDisposable

<div class="vv-root">
    <!-- Top bar -->
    <header class="vv-topbar">
        <div class="vv-topbar-left">
            <div class="vv-logo">
                <div class="vv-logo-badge">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M7 1L13 4V10L7 13L1 10V4L7 1Z" fill="white"></path>
                    </svg>
                </div>
                <span class="vv-logo-text">VoyageVista</span>
            </div>
            <div class="vv-divider hidden-md"></div>
            <span class="vv-intern-label hidden-md">Intern Platform</span>
        </div>

        <!-- Desktop nav -->
        <nav class="vv-nav hidden-lg">
            @foreach (var d in Departementen)
            {
                <button class="vv-nav-btn @(ActiveDepartment == d.Id ? "vv-nav-btn-active" : "")"
                        @onclick="() => Navigeer(d.Id)">
                    @d.Kort
                </button>
            }
        </nav>

        <!-- Mobile hamburger -->
        <button class="vv-hamburger lg-hidden" @onclick="ToggleMobileNav">
            @if (MobileNavOpen)
            {
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
                    <line x1="3" y1="3" x2="15" y2="15" />
                    <line x1="15" y1="3" x2="3" y2="15" />
                </svg>
            }
            else
            {
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
                    <line x1="2" y1="5" x2="16" y2="5" />
                    <line x1="2" y1="9" x2="16" y2="9" />
                    <line x1="2" y1="13" x2="16" y2="13" />
                </svg>
            }
        </button>

        <div class="vv-topbar-right hidden-lg">
            <div class="vv-avatar">JV</div>
        </div>
    </header>

    <!-- Mobile dropdown nav -->
    @if (MobileNavOpen)
    {
        <div class="vv-mobile-nav lg-hidden">
            @foreach (var d in Departementen)
            {
                <button class="vv-mobile-nav-item @(ActiveDepartment == d.Id ? "vv-mobile-nav-item-active" : "")"
                        @onclick="() => Navigeer(d.Id)">
                    @d.Label
                </button>
            }
        </div>
    }

    <!-- Breadcrumb bar -->
    <div class="vv-breadcrumb">
        <span class="vv-breadcrumb-part">VoyageVista</span>
        <span>/</span>
        <span class="vv-breadcrumb-current @(ActiveDepartment == "sales" ? "vv-breadcrumb-primary" : "")">
            @ActiveDepartmentLabel
        </span>
    </div>

    <!-- Page content -->
    <main class="vv-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private sealed record Departement(string Id, string Label, string Kort);

    private static readonly Departement[] Departementen =
    {
        new("marketing", "Marketing & Communicatie", "Marketing"),
        new("sales", "Sales & Boekingen", "Sales"),
        new("klantenservice", "Klantenservice & Support", "Support"),
        new("productontwikkeling", "Productontwikkeling & Inkoop", "Producten"),
        new("financien", "Financiën & Administratie", "Financiën"),
        new("it", "IT & Innovatie", "IT"),
    };

    private string ActiveDepartment { get; set; } = "sales";
    private bool MobileNavOpen { get; set; }

    private string ActiveDepartmentLabel =>
        Departementen.FirstOrDefault(d => d.Id == ActiveDepartment)?.Label ?? "Sales & Boekingen";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdateFromUri(Nav.Uri);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateFromUri(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdateFromUri(string uri)
    {
        var path = uri.Replace(Nav.BaseUri, string.Empty).TrimStart('/');
        var segment = path.Split('/').FirstOrDefault();
        if (!string.IsNullOrEmpty(segment) && Departementen.Any(d => d.Id == segment))
        {
            ActiveDepartment = segment;
        }
        else
        {
            ActiveDepartment = "sales";
        }
    }

    private async Task ToggleMobileNav()
    {
        MobileNavOpen = !MobileNavOpen;
        if (MobileNavOpen)
        {
            await Task.Yield();
        }
    }

    private void Navigeer(string id)
    {
        MobileNavOpen = false;
        Nav.NavigateTo($"/{id}");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
